<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="430.0" prefWidth="546.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.empresaviews.controller.ClienteController">
   <children>
      <Label layoutX="163.0" layoutY="32.0" text="REGISTRO DE CLIENTES">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="189.0" layoutY="64.0" text="Debe completar todos los campos.">
         <font>
            <Font size="11.0" />
         </font>
      </Label>
      <Separator layoutX="21.0" layoutY="95.0" prefHeight="16.0" prefWidth="493.0" />
      <GridPane layoutX="25.0" layoutY="133.0" prefHeight="180.0" prefWidth="493.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="201.0" minWidth="10.0" prefWidth="164.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="338.0" minWidth="10.0" prefWidth="329.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nombre:" />
            <TextField fx:id="txtNombre" promptText="Ingrese el nombre del cliente" GridPane.columnIndex="1" />
            <Label text="Correo:" GridPane.rowIndex="1" />
            <TextField fx:id="txtCorreo" promptText="Ingrese el correo del cliente" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Teléfono:" GridPane.rowIndex="2" />
            <TextField fx:id="txtTelefono" prefHeight="25.0" prefWidth="106.0" promptText="Ingrese el teléfono del cliente" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Tipo de cliente:" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbTipoCliente" prefHeight="25.0" prefWidth="237.0" promptText="Seleccione el tipo de cliente" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Documento de identificación:" GridPane.rowIndex="4" />
            <Label text="Directorio:" GridPane.rowIndex="5" />
         </children>
      </GridPane>
      <TextField fx:id="txtDirectorio" editable="false" layoutX="189.0" layoutY="286.0" prefHeight="25.0" prefWidth="238.0" promptText="Seleccione el directorio del cliente" />
      <TextField fx:id="txtDocumento" editable="false" layoutX="189.0" layoutY="256.0" prefHeight="25.0" prefWidth="238.0" promptText="Seleccione el documento de identificación" />
      <Button fx:id="btnSeleccionarDocumento" defaultButton="true" layoutX="432.0" layoutY="256.0" mnemonicParsing="false" onAction="#seleccionarDocumento" prefHeight="25.0" prefWidth="81.0" text="Seleccionar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button fx:id="btnSeleccionarDirectorio" defaultButton="true" layoutX="432.0" layoutY="286.0" mnemonicParsing="false" onAction="#seleccionarDirectorio" prefHeight="25.0" prefWidth="81.0" text="Seleccionar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button fx:id="btnLimpiarControles" layoutX="310.0" layoutY="342.0" mnemonicParsing="false" onAction="#limpiarControles" prefHeight="48.0" prefWidth="96.0" text="Limpiar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button fx:id="btnRegistrar" defaultButton="true" layoutX="417.0" layoutY="342.0" mnemonicParsing="false" onAction="#registrarCliente" prefHeight="48.0" prefWidth="96.0" text="Registrar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button fx:id="btnCerrar" layoutX="203.0" layoutY="342.0" mnemonicParsing="false" onAction="#cerrarSistema" prefHeight="48.0" prefWidth="96.0" text="Cerrar">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
